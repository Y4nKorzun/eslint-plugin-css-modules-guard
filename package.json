{
  "name": "eslint-plugin-css-modules-guard",
  "version": "0.4.0",
  "description": "ESLint checks for real CSS Modules class names, compiled from source at lint time.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/src/cli.js",
      "default": "./dist/src/cli.js"
    }
  },
  "bin": {
    "css-modules-lint": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/plugin.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 dist/test/plugin.test.js",
    "check": "npm run test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "css-modules",
    "sass"
  ],
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0",
    "postcss": "^8.0.0",
    "postcss-selector-parser": "^7.0.0",
    "sass": "^1.0.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0"
  }
}
