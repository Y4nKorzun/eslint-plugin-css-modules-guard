{
  "name": "eslint-plugin-css-modules-guard",
  "version": "1.0.0",
  "description": "ESLint 9/10 plugin that validates CSS Modules against local CSS, SCSS, Sass, and Less source.",
  "author": {
    "name": "Y4nKorzun",
    "url": "https://github.com/Y4nKorzun"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y4nKorzun/eslint-plugin-css-modules-guard.git"
  },
  "bugs": {
    "url": "https://github.com/Y4nKorzun/eslint-plugin-css-modules-guard/issues"
  },
  "homepage": "https://github.com/Y4nKorzun/eslint-plugin-css-modules-guard#readme",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/src/cli.js",
      "default": "./dist/src/cli.js"
    }
  },
  "bin": {
    "css-modules-lint": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/plugin.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude='dist/test/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 dist/test/plugin.test.js",
    "check": "npm run test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslint-plugin-css-modules",
    "css-modules",
    "css-module",
    "css-modules-lint",
    "less",
    "scss",
    "sass",
    "typescript"
  ],
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "less": "^4.0.0",
    "sass": "^1.45.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependenciesMeta": {
    "less": {
      "optional": true
    },
    "sass": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0",
    "postcss": "^8.0.0",
    "postcss-selector-parser": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "less": "^4.8.1",
    "sass": "^1.102.0",
    "typescript": "^5.9.3"
  }
}
